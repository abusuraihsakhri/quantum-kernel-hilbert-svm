{
  "openapi": "3.1.0",
  "info": {
    "title": "Quantum Kernel SVM and Threshold Assessment API",
    "description": "Noiseless quantum fidelity kernel endpoint and separate legacy deterministic threshold evaluation. No cryptographic protocol conformance or quantum-hardware claims.",
    "version": "3.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON operational counters (not Prometheus exposition format)",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock supervisory response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/kernel": {
      "post": {
        "summary": "Calculate noiseless fidelity Gram matrix for up to 24 feature vectors",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "points": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 24,
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "reps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4,
                    "default": 2
                  }
                },
                "required": [
                  "points"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fidelity kernel matrix"
          },
          "422": {
            "description": "Invalid feature vectors"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Browser workspace",
        "responses": {
          "200": {
            "description": "HTML user interface"
          },
          "404": {
            "description": "Browser UI not packaged"
          }
        }
      }
    }
  }
}
